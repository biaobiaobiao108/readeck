{
  "name": "readeck-bun",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "bun --filter \"*\" dev",
    "dev:server": "bun --filter server dev",
    "dev:web": "bun --filter web dev",
    "build": "bun --filter web build",
    "start": "bun apps/server/src/index.ts",
    "test": "bun test",
    "check": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^7.0.2"
  }
}
